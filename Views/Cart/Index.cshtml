@model List<CartLine>
@{ViewData["Title"]="Your cart";}
<h1 class="h2 mb-4">Your shopping cart</h1>
@if(!Model.Any()){<div class="empty-state text-center p-5"><div class="display-4">🛒</div><h2 class="h4 mt-3">Your cart is waiting for some pawsome finds.</h2><a class="btn btn-primary mt-3" asp-controller="Products" asp-action="Index">Continue shopping</a></div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Product</th><th>Unit price</th><th>Quantity</th><th>Subtotal</th><th></th></tr></thead><tbody>@foreach(var line in Model){<tr><td><div class="d-flex align-items-center gap-3"><img class="cart-thumb" src="@line.ImageUrl" alt=""/><div><strong>@line.Name</strong><div class="small text-muted">Stock: @line.Stock</div></div></div></td><td>£@line.Price.ToString("0.00")</td><td><form asp-action="Update" method="post" class="d-flex gap-2"><input type="hidden" name="productId" value="@line.ProductId"/><input class="form-control" style="max-width:85px" type="number" min="1" max="@line.Stock" name="quantity" value="@line.Quantity"/><button class="btn btn-outline-secondary btn-sm">Update</button></form></td><td class="fw-bold">£@line.Subtotal.ToString("0.00")</td><td><form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@line.ProductId"/><button class="btn btn-link text-danger">Remove</button></form></td></tr>}</tbody></table></div><div class="d-flex justify-content-end"><div class="summary-card"><div class="d-flex justify-content-between gap-5"><span>Selected items total</span><strong>£@Model.Sum(x=>x.Subtotal).ToString("0.00")</strong></div><p class="small text-muted mt-2">Shipping is calculated at checkout. Free shipping on orders of £50 or more.</p><form asp-action="Checkout" method="post"><button class="btn btn-primary w-100">Proceed to checkout</button></form></div></div>}
