@model List<CartLine>

@{
    ViewData["Title"] = "Your cart";

    var subtotal = Model.Sum(x => x.Subtotal);
    var itemCount = Model.Sum(x => x.Quantity);
}

<div class="paw-cart-page">

    <!-- Illustration only; cart amounts and product photos still use the live cart model. -->
    <header class="paw-page-hero paw-page-hero-cart mb-4">
        <div class="paw-page-hero-copy">
            <span class="paw-cart-eyebrow">🐾 YOUR PAWPUFF BASKET</span>
            <h1 class="paw-page-hero-title">Your shopping cart <span class="paw-heart" aria-hidden="true">♡</span></h1>
            <p>Ready to treat your furry friend?</p>
            <a class="paw-cart-continue" asp-controller="Products" asp-action="Index">← Continue shopping</a>
        </div>
        <img class="paw-page-hero-pets" src="~/images/brand/paws-header.png" alt="" />
    </header>

    @if (!Model.Any())
    {
        <!-- Empty cart -->
        <div class="paw-cart-empty text-center">

            <div class="paw-cart-empty-icon">
                🛒
            </div>

            <h2 class="h4 fw-bold mt-3">
                Your cart is waiting for some pawsome finds.
            </h2>

            <p class="text-muted">
                Discover something special for your furry friend.
            </p>

            <a class="btn btn-paw btn-lg mt-3"
               asp-controller="Products"
               asp-action="Index">
                Explore the shop
            </a>

        </div>
    }
    else
    {
        <div class="row g-4">

            <!-- Left: cart products -->
            <div class="col-lg-8">

                <div class="paw-cart-panel">

                    <div class="paw-cart-panel-heading">
                        <h2 class="h5 fw-bold mb-0">
                            Cart items
                        </h2>

                        <span class="paw-cart-count" data-cart-count-label>
                            @itemCount item(s)
                        </span>
                    </div>

                    @foreach (var line in Model)
                    {
                        var photo = string.IsNullOrWhiteSpace(line.ImageUrl)
                        ? Url.Content("~/images/pawpuff-placeholder.svg")
                        : line.ImageUrl;

                        <div class="paw-cart-item" data-cart-line data-unit-price="@line.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                            <!-- Product image -->
                            <div class="paw-cart-image">
                                <img src="@photo"
                                     alt="@line.Name"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='/images/pawpuff-placeholder.svg';" />
                            </div>

                            <!-- Product information -->
                            <div class="paw-cart-item-info">

                                <h3 class="paw-cart-product-name">
                                    @line.Name
                                </h3>

                                <div class="paw-cart-unit-price">
                                    £@line.Price.ToString("0.00") each
                                </div>

                                <div class="paw-cart-stock">
                                    Stock: @line.Stock
                                </div>

                                <!-- Keep original update action -->
                                <form asp-action="Update"
                                      method="post"
                                      class="paw-cart-update-form">

                                    <input type="hidden"
                                           name="productId"
                                           value="@line.ProductId" />

                                    <label class="small fw-semibold"
                                           for="qty-@line.ProductId">
                                        Qty
                                    </label>

                                    <input id="qty-@line.ProductId"
                                           class="form-control form-control-sm"
                                           type="number"
                                           name="quantity"
                                           min="1"
                                           max="@line.Stock"
                                           value="@line.Quantity"
                                           required />

                                    <button type="submit"
                                            class="btn btn-outline-secondary btn-sm">
                                        Update
                                    </button>

                                </form>

                            </div>

                            <!-- Subtotal and remove -->
                            <div class="paw-cart-item-end">

                                <div class="paw-cart-line-total" data-line-total>
                                    £@line.Subtotal.ToString("0.00")
                                </div>

                                <!-- Keep original remove action -->
                                <form asp-action="Remove"
                                      method="post">

                                    <input type="hidden"
                                           name="productId"
                                           value="@line.ProductId" />

                                    <button type="submit"
                                            class="paw-cart-remove">
                                        Remove
                                    </button>

                                </form>

                            </div>

                        </div>
                    }

                </div>
            </div>

            <!-- Right: order summary -->
            <div class="col-lg-4">

                <div class="paw-cart-summary">

                    <h2 class="h5 fw-bold mb-4">
                        Order summary
                    </h2>

                    <div class="paw-cart-summary-row">
                        <span>Items (<span data-cart-count>@itemCount</span>)</span>
                        <strong data-cart-subtotal>
                            £@subtotal.ToString("0.00")
                        </strong>
                    </div>

                    <div class="paw-cart-summary-row">
                        <span>Shipping</span>
                        <span class="text-muted small">
                            Calculated at checkout
                        </span>
                    </div>

                    <div class="paw-cart-shipping-note">
                        🚚 Free shipping on orders of £50 or more.
                    </div>

                    <hr />

                    <div class="paw-cart-summary-total">
                        <span>Items total</span>
                        <strong data-cart-subtotal>
                            £@subtotal.ToString("0.00")
                        </strong>
                    </div>

                    <!-- Keep original checkout action -->
                    <form asp-action="Checkout"
                          method="post"
                          class="mt-4">

                        <button type="submit"
                                class="btn btn-paw btn-lg w-100">
                            Proceed to checkout →
                        </button>

                    </form>

                    <p class="paw-cart-summary-caption">
                        Review your order before payment.
                    </p>

                </div>
            </div>

        </div>
    }

</div>

@section Scripts {
<script>
    (function () {
        const money = amount => '£' + amount.toFixed(2);
        const rows = Array.from(document.querySelectorAll('[data-cart-line]'));
        if (!rows.length) return;

        function refreshTotals() {
            let total = 0, quantity = 0;
            for (const row of rows) {
                const input = row.querySelector('input[name="quantity"]');
                const price = Number(row.dataset.unitPrice);
                const qty = Number(input?.value);
                if (!input || !Number.isFinite(price) || !Number.isInteger(qty) || qty < 1) continue;
                total += price * qty;
                quantity += qty;
                const amount = row.querySelector('[data-line-total]');
                if (amount) amount.textContent = money(price * qty);
            }
            document.querySelectorAll('[data-cart-subtotal]').forEach(el => el.textContent = money(total));
            document.querySelectorAll('[data-cart-count]').forEach(el => el.textContent = quantity);
            const label = document.querySelector('[data-cart-count-label]');
            if (label) label.textContent = quantity + ' item(s)';
        }

        for (const row of rows) {
            const input = row.querySelector('input[name="quantity"]');
            const form = row.querySelector('.paw-cart-update-form');
            input?.addEventListener('input', refreshTotals);
            input?.addEventListener('change', function () {
                // Save the updated quantity on change so checkout sees the same number.
                if (input.checkValidity()) form?.requestSubmit();
            });
        }
    })();
</script>
}
