@{ViewData["Title"]="Register";}
<div class="auth-card mx-auto"><h1 class="h3 mb-4">Create your account</h1><form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><label class="form-label">Display name</label><input class="form-control mb-3" name="displayName" required/><label class="form-label">Email</label><input class="form-control mb-3" type="email" name="email" required/><label class="form-label">Password (at least 6 characters)</label><input class="form-control mb-3" type="password" name="password" minlength="6" required/><label class="form-label">Account type</label><select class="form-select mb-4" name="role"><option value="Buyer">Buyer</option><option value="Seller">Seller</option></select><button class="btn btn-primary w-100">Register</button></form></div>
