@{ ViewData["Title"] = "Login"; }
<div class="paw-auth-scene">
  <div class="auth-card mx-auto">
    <div class="paw-auth-mascot" aria-hidden="true">🐱 <span>♡</span> 🐶</div>
    <h1 class="h3 mb-4">Welcome back</h1>
    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <label class="form-label" for="email">Email</label>
        <input class="form-control mb-3" id="email" type="email" name="email" required />
        <label class="form-label" for="password">Password</label>
        <input class="form-control mb-4" id="password" type="password" name="password" required />
        <button class="btn btn-paw w-100" type="submit">Login</button>
    </form>
    <p class="mt-3 mb-0">New here? <a asp-action="Register">Create an account</a></p>
</div>
</div>
