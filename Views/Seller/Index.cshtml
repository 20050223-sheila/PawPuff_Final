@model IEnumerable<Product>
@{ViewData["Title"]="Seller products";}
<div class="d-flex justify-content-between mb-4"><div><h1 class="h2">Seller product management</h1><p class="text-muted">Create and maintain your product catalogue.</p></div><a class="btn btn-primary align-self-start" asp-controller="Products" asp-action="Create">＋ Add product</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name</td><td>@p.PetType / @p.Category</td><td>£@p.Price.ToString("0.00")</td><td>@p.Stock</td><td>@(p.IsActive?"Active":"Hidden")</td><td><a asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id">Edit</a></td></tr>}</tbody></table></div>
