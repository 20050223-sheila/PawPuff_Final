@model OperationsNewProductViewModel
@{
    ViewData["Title"] = "Publish new product";
}
<div class="paw-operations">
    <a asp-action="Index" class="paw-cart-continue">← Operations dashboard</a>
    <div class="mb-4 mt-3">
        <span class="paw-cart-eyebrow">🐾 NEW PAWPUFF COLLECTION</span>
        <h1 class="h2 fw-bold mt-2">Publish a new product</h1>
        <p class="text-muted">The product will appear in the shop and on the homepage's New Arrivals section.</p>
    </div>
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="panel paw-operation-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold">Product name *</label>
            <input asp-for="Name" class="form-control" maxlength="100" placeholder="e.g. Cozy Cotton Dog Bed" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="PetType" class="form-label fw-semibold">Pet type *</label>
                <select asp-for="PetType" class="form-select"><option value="Dog">Dog</option><option value="Cat">Cat</option></select>
                <span asp-validation-for="PetType" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Category" class="form-label fw-semibold">Category *</label>
                <input asp-for="Category" class="form-control" list="productCategoryChoices" maxlength="100" placeholder="Food, Toys, Accessories..." />
                <datalist id="productCategoryChoices"><option value="Food"></option><option value="Treats"></option><option value="Toys"></option><option value="Clothing"></option><option value="Grooming"></option><option value="Accessories"></option><option value="Daily Essentials"></option></datalist>
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold">Product description *</label>
            <textarea asp-for="Description" class="form-control" rows="5" maxlength="1000" placeholder="What makes this new product special?"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Price" class="form-label fw-semibold">Price (£) *</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Stock" class="form-label fw-semibold">Stock quantity *</label>
                <input asp-for="Stock" class="form-control" type="number" step="1" min="0" />
                <span asp-validation-for="Stock" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="ImageFile" class="form-label fw-semibold">Upload product photo</label>
            <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif" />
            <span asp-validation-for="ImageFile" class="text-danger small"></span>
            <p class="small text-muted mt-1 mb-0">JPEG / PNG / WEBP / GIF, up to 5 MB. One photo per product.</p>
        </div>
        <div class="mb-4">
            <label asp-for="ImageUrl" class="form-label">Or provide an image URL</label>
            <input asp-for="ImageUrl" class="form-control" type="url" placeholder="https://..." />
            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-paw btn-lg">Publish new product</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancel</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
