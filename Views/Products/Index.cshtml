@model IEnumerable<Product>
@{ViewData["Title"]="Shop";}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><div><h1 class="h2">Shop pet essentials</h1><p class="text-muted mb-0">Find something for every furry friend.</p></div>@if(User.IsInRole("Admin")||User.IsInRole("Seller")){<a class="btn btn-primary" asp-action="Create">＋ Add product</a>}</div>
<form method="get" class="filter-panel row g-2 mb-4"><div class="col-md-4"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search products..."/></div><div class="col-6 col-md-2"><select class="form-select" name="petType"><option value="">All pets</option><option selected="@(ViewBag.PetType as string=="Cat")" value="Cat">Cats</option><option selected="@(ViewBag.PetType as string=="Dog")" value="Dog">Dogs</option></select></div><div class="col-6 col-md-2"><select class="form-select" name="category"><option value="">All categories</option>@foreach(var c in new[]{"Food","Treats","Clothing","Daily Essentials","Toys"}){<option selected="@(ViewBag.Category as string==c)" value="@c">@c</option>}</select></div><div class="col-6 col-md-1"><input class="form-control" type="number" min="0" step="1" name="minPrice" value="@ViewBag.MinPrice" placeholder="Min £"/></div><div class="col-6 col-md-1"><input class="form-control" type="number" min="0" step="1" name="maxPrice" value="@ViewBag.MaxPrice" placeholder="Max £"/></div><div class="col-md-2 d-grid"><button class="btn btn-dark">Search / Filter</button></div></form>
<div class="row g-4">@foreach(var p in Model){<div class="col-6 col-md-4 col-lg-3"><div class="card product-card h-100"><img class="card-img-top" src="@p.ImageUrl" alt="@p.Name"/><div class="card-body d-flex flex-column"><div class="small text-muted">@p.PetType · @p.Category</div><h2 class="h6 mt-2">@p.Name</h2><p class="small text-muted">@p.Description</p><div class="mt-auto d-flex justify-content-between align-items-center"><strong>£@p.Price.ToString("0.00")</strong><span class="small">Stock: @p.Stock</span></div><a class="btn btn-primary btn-sm mt-3" asp-action="Details" asp-route-id="@p.Id">View product</a></div></div></div>}</div>
@if(ViewBag.TotalPages>1){<nav class="mt-4"><ul class="pagination">@for(int i=1;i<=(int)ViewBag.TotalPages;i++){<li class="page-item @(i==(int)ViewBag.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-petType="@ViewBag.PetType" asp-route-category="@ViewBag.Category" asp-route-minPrice="@ViewBag.MinPrice" asp-route-maxPrice="@ViewBag.MaxPrice">@i</a></li>}</ul></nav>}
