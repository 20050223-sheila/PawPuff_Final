@model Product
@{ViewData["Title"]="Edit product";}
<h1 class="h2">Edit product</h1><form asp-action="Edit" method="post" class="form-panel"><input type="hidden" asp-for="Id"/><input type="hidden" name="originalStock" value="@Model.Stock"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><partial name="_ProductForm" model="Model"/><button class="btn btn-primary">Save changes</button><a class="btn btn-link" asp-action="Index">Cancel</a></form>
