@model Product
@{ViewData["Title"]=Model.Name;}
<div class="row g-5"><div class="col-md-6"><img class="img-fluid rounded-4 detail-image" src="@Model.ImageUrl" alt="@Model.Name"/></div><div class="col-md-6"><span class="text-muted">@Model.PetType / @Model.Category</span><h1 class="display-6 fw-bold mt-2">@Model.Name</h1><p class="display-6 text-primary">£@Model.Price.ToString("0.00")</p><p>@Model.Description</p><p class="small text-muted">Available stock: @Model.Stock</p><form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2 align-items-center"><input type="hidden" name="productId" value="@Model.Id"/><label for="quantity">Qty</label><input id="quantity" class="form-control" style="max-width:100px" type="number" name="quantity" min="1" max="@Model.Stock" value="1"/><button class="btn btn-primary" disabled="@(Model.Stock<1)">Add to cart</button></form><a class="btn btn-link mt-3 ps-0" asp-action="Index">← Back to shop</a></div></div>
