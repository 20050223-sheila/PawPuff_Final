@model Product
@{ViewData["Title"]="Remove product";}
<div class="form-panel"><h1 class="h3">Take this product off the shop?</h1><p>@Model.Name · £@Model.Price.ToString("0.00")</p><p class="text-muted">This performs a soft delete, so existing order history is preserved.</p><form asp-action="Delete" method="post"><input type="hidden" asp-for="Id"/><button class="btn btn-danger">Remove product</button><a class="btn btn-link" asp-action="Index">Cancel</a></form></div>
