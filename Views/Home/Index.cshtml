@model IEnumerable<Product>

@{
    ViewData["Title"] = "Home";
}

<div class="paw-home">

    <!-- Hero banner -->
    <section class="paw-home-hero mb-4">
        <div class="row align-items-center g-4">

            <div class="col-lg-8">
                <span class="paw-home-label">
                    🐾 A LITTLE LOVE FOR EVERY PAW
                </span>

                <h1 class="display-5 fw-bold mt-3 mb-3">
                    Everything your best friend needs.
                </h1>

                <p class="lead mb-4">
                    Discover food, toys, treats and everyday
                    essentials for cats and dogs.
                </p>

                <a class="btn btn-paw btn-lg"
                   asp-controller="Products"
                   asp-action="Index">
                    Explore the shop
                </a>
            </div>

            <div class="col-lg-4 text-center">
                <div class="paw-home-decoration">
                    <div class="paw-home-paw">🐾</div>
                    <div class="fw-semibold">
                        Happy pets, happy homes.
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Pet categories -->
    <section class="mb-5">

        <div class="row g-3">

            <div class="col-md-6">
                <a class="paw-home-category paw-cat-category"
                   asp-controller="Products"
                   asp-action="Index"
                   asp-route-petType="Cat">

                    <div class="paw-home-category-icon">🐱</div>

                    <div>
                        <h2 class="h4 fw-bold mb-1">
                            Shop for Cats
                        </h2>

                        <p class="mb-0">
                            Toys, treats, food and everyday essentials
                        </p>
                    </div>

                    <span class="paw-home-category-arrow">
                        →
                    </span>
                </a>
            </div>

            <div class="col-md-6">
                <a class="paw-home-category paw-dog-category"
                   asp-controller="Products"
                   asp-action="Index"
                   asp-route-petType="Dog">

                    <div class="paw-home-category-icon">🐶</div>

                    <div>
                        <h2 class="h4 fw-bold mb-1">
                            Shop for Dogs
                        </h2>

                        <p class="mb-0">
                            Food, toys, treats and accessories
                        </p>
                    </div>

                    <span class="paw-home-category-arrow">
                        →
                    </span>
                </a>
            </div>

        </div>
    </section>

    <!-- Popular products -->
    <section class="mb-5">

        <div class="d-flex justify-content-between
                    align-items-center gap-3 mb-4">

            <div>
                <span class="paw-home-section-label">
                    HANDPICKED FOR HAPPY PAWS
                </span>

                <h2 class="h3 fw-bold mt-1 mb-0">
                    Popular picks
                </h2>
            </div>

            <a class="paw-home-view-all"
               asp-controller="Products"
               asp-action="Index">
                View all products →
            </a>
        </div>

        @if (!Model.Any())

        {
            <div class="text-center py-5">
                <h3 class="h5">Products coming soon</h3>
                <p class="text-muted">
                    Check back soon for our pet essentials.
                </p>
            </div>
        }

        else

        {
            <div class="row g-3 g-lg-4">

                @foreach (var p in Model)

                {

                    var photo = string.IsNullOrWhiteSpace(p.ImageUrl)

                    ? Url.Content("~/images/pawpuff-placeholder.svg")

                    : p.ImageUrl;

                    <div class="col-6 col-md-4 col-lg-3">

                        <div class="card paw-home-product h-100">

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@p.Id"
                               class="text-decoration-none">

                                <div class="paw-home-product-image">
                                    <img src="@photo"
                                         alt="@p.Name"
                                         loading="lazy"
                                         onerror="this.onerror=null;this.src='/images/pawpuff-placeholder.svg';" />
                                </div>
                            </a>

                            <div class="card-body d-flex flex-column p-3">

                                <div class="paw-home-product-category mb-2">
                                    @p.PetType · @p.Category
                                </div>

                                <h3 class="paw-home-product-title mb-3">
                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@p.Id">
                                        @p.Name
                                    </a>
                                </h3>

                                <div class="mt-auto">

                                    <div class="paw-home-product-price mb-3">
                                        £@p.Price.ToString("0.00")
                                    </div>

                                    <a class="btn btn-paw w-100"
                                       asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@p.Id">
                                        View details
                                    </a>

                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- Bottom banner -->
    <section class="paw-home-bottom text-center">
        <div class="paw-home-bottom-icon">🐾</div>

        <h2 class="h3 fw-bold">
            A little happiness in every order.
        </h2>

        <p class="mb-4">
            Find something special for your furry best friend.
        </p>

        <a class="btn btn-paw btn-lg"
           asp-controller="Products"
           asp-action="Index">
            Shop all products
        </a>
    </section>

</div>
