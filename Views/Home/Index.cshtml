@model IEnumerable<Product>
@{ViewData["Title"]="Home";}
<section class="hero rounded-4 p-5 mb-5"><div class="col-lg-7"><span class="badge text-bg-light mb-3">A little love for every paw</span><h1 class="display-5 fw-bold">Everything your best friend needs.</h1><p class="lead">Shop food, toys, treats and everyday essentials for cats and dogs.</p><a class="btn btn-primary btn-lg" asp-controller="Products" asp-action="Index">Explore the shop</a></div></section>
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h3">Popular picks</h2><a asp-controller="Products" asp-action="Index">View all products →</a></div><div class="row g-4">@foreach(var p in Model){<div class="col-6 col-md-4 col-lg-3"><div class="card product-card h-100"><img class="card-img-top" src="@p.ImageUrl" alt="@p.Name"/><div class="card-body d-flex flex-column"><span class="text-muted small">@p.PetType · @p.Category</span><h3 class="h6 mt-1">@p.Name</h3><strong class="mt-auto">£@p.Price.ToString("0.00")</strong><a class="btn btn-outline-primary btn-sm mt-3" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">View details</a></div></div></div>}</div>
