@model CreateOperatorViewModel
@{
    ViewData["Title"] = "Create operator account";
}
<div class="form-panel">
    <a asp-action="Index" class="btn btn-link ps-0">← Admin dashboard</a>
    <h1 class="h3 mb-3">Create operator account</h1>
    <p class="text-muted">This is an admin-only action. Operators cannot register themselves publicly or create other operators.</p>
    <form asp-action="CreateOperator" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <div class="mb-3"><label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="off" />
            <span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="UserName" class="form-label">Username</label>
            <input asp-for="UserName" class="form-control" autocomplete="off" />
            <span asp-validation-for="UserName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label">Initial password</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span></div>
        <button class="btn btn-paw" type="submit">Create operator</button>
    </form>
</div>
