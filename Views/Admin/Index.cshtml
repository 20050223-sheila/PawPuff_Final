@model IEnumerable<Order>
@{ViewData["Title"]="Admin dashboard";}
<h1 class="h2 mb-4">Admin dashboard</h1><div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="stat-card"><span>Active products</span><strong>@ViewBag.ProductCount</strong></div></div><div class="col-6 col-lg-3"><div class="stat-card"><span>Total orders</span><strong>@ViewBag.OrderCount</strong></div></div><div class="col-6 col-lg-3"><div class="stat-card"><span>Registered users</span><strong>@ViewBag.Users</strong></div></div><div class="col-6 col-lg-3"><div class="stat-card"><span>Recorded revenue</span><strong>£@(((decimal)ViewBag.Revenue).ToString("0.00"))</strong></div></div></div><div class="d-flex justify-content-between mb-3"><h2 class="h4">Recent orders</h2><a class="btn btn-primary btn-sm" asp-controller="Products" asp-action="Create">Add product</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Payment</th><th>Status</th><th>Update status</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>#@o.Id</td><td>@o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>£@o.Total.ToString("0.00")</td><td>@o.PaymentMethod</td><td>@o.Status</td><td><form asp-action="UpdateStatus" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@o.Id"/><select name="status" class="form-select form-select-sm"><option>Pending</option><option>Shipped</option><option>Completed</option><option>Cancelled</option></select><button class="btn btn-sm btn-outline-primary">Save</button></form></td></tr>}</tbody></table></div>
